{
  "appId": "com.lightwork.app",
  "appName": "Lightwork",
  "webDir": "www",
  "bundledWebRuntime": false,
  "ios": {
    "contentInset": "never",
    "preferredContentMode": "mobile",
    "backgroundColor": "#080412"
  },
  "plugins": {
    "SplashScreen": {
      "launchAutoHide": true,
      "backgroundColor": "#080412",
      "showSpinner": false
    },
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#00000000",
      "overlaysWebView": true
    }
  }
}
